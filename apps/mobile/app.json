{
  "expo": {
    "name": "TECHNOVA",
    "slug": "technova",
    "scheme": "technova",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.heartcode.technova"
    },
    "android": {
      "package": "com.heartcode.technova",
      "adaptiveIcon": {
        "backgroundColor": "#F4F1EA"
      }
    },
    "plugins": [
      "expo-router",
      ["expo-secure-store", { "configureAndroidBackup": true }]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}