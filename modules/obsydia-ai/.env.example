# Dark Obsydia AI — configuration
# Copy to .env (the installer does it for you). Never commit .env.

NODE_ENV=production
PORT=8080
APP_NAME=OBSYDIA AI
APP_CREATOR=Inconnu Boy Sensei
APP_EMAIL=admin@example.com
APP_URL=http://localhost
CORS_ORIGINS=
TRUST_PROXY=1
DATA_DIR=./data
PREVIEW_URL=

# AI identity (can be changed later from Administration → AI configuration)
AI_DISPLAY_NAME=OBSYDIA
AI_PERSONALITY=Professional, intelligent, friendly, precise and technically advanced.
AI_SYSTEM_PROMPT="You are OBSYDIA AI, an advanced AI assistant created by Inconnu Boy Sensei. You help with programming, development, research, explanations and project generation. Be professional, accurate and helpful. When asked who created you, identify Inconnu Boy Sensei as your creator."
AI_WELCOME_MESSAGE=Welcome to OBSYDIA AI. What would you like to create today?
AI_DEFAULT_LANGUAGE=auto
AI_MAX_OUTPUT_TOKENS=2048
AI_PROJECT_MAX_OUTPUT_TOKENS=8192
AI_CONTEXT_MESSAGES=16

# Local AI with Ollama (default). The installer picks a Qwen model that fits your RAM.
AI_PROVIDER=ollama
OLLAMA_URL=http://ollama:11434/v1
OLLAMA_MODEL=qwen3:4b
OLLAMA_CONTEXT_LENGTH=8192
AI_MODELS=

# Optional: any OpenAI-compatible API instead of Ollama (AI_PROVIDER=deepseek or a custom name)
AI_BASE_URL=
AI_MODEL=
AI_API_KEYS=[]
AI_TIMEOUT_MS=
AI_MAX_RETRIES=
AI_EXTRA_BODY=
AI_MAX_OUTPUT_CAP=0
AI_SUPPORTS_VISION=
AI_SUPPORTS_AUDIO=
AI_SUPPORTS_TOOLS=

# Optional speech-to-text (OpenAI-compatible /audio/transcriptions)
TRANSCRIPTION_BASE_URL=
TRANSCRIPTION_API_KEY=
TRANSCRIPTION_MODEL=whisper-1

# Database (Docker builds MONGODB_URI from MONGO_ROOT_*)
MONGODB_URI=
MONGO_ROOT_USER=obsydia
MONGO_ROOT_PASSWORD=
MONGO_CACHE_GB=0.5
REDIS_URL=

# Secrets — generate with: openssl rand -hex 32
JWT_SECRET=
SESSION_SECRET=
ENCRYPTION_KEY=
SESSION_TTL_DAYS=30

# First administrator (created on first start)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Email (for Gmail: smtp.gmail.com, port 587 and an App Password)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Google sign-in (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Payments (optional)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_MODE=sandbox
PAYPAL_PLAN_ID_PRO=
PAYPAL_PLAN_ID_PREMIUM=

# Domain & HTTPS
DOMAIN=
ACME_EMAIL=

# Plans & tokens
FREE_TOKEN_LIMIT=25000
FREE_TOKEN_RESET_HOURS=168
PRO_TOKEN_LIMIT=60000
PRO_TOKEN_RESET_HOURS=7
PREMIUM_TOKEN_LIMIT=300000
PREMIUM_TOKEN_RESET_HOURS=7
PRO_PRICE_USD=1.99
PREMIUM_PRICE_USD=5.00
REFERRAL_REQUIRED=5
REFERRAL_REWARD_TOKENS=10000
MAX_TEAM_INVITES=3

# Ads (optional, editable in Administration → Ads)
ADS_ENABLED=false
ADS_NATIVE_SRC=
ADS_NATIVE_CONTAINER=
ADS_SOCIAL_SRC=
ADS_SMARTLINK=
ADS_SOCIAL_DELAY_SECONDS=20
ADS_FREE_PLANS=premium,custom

# Community link (optional)
COMMUNITY_WHATSAPP_URL=
COMMUNITY_PROMPT_ENABLED=false
COMMUNITY_PROMPT_DELAY_SECONDS=6

# Limits
MAX_UPLOAD_MB=25
MAX_ZIP_ENTRIES=2000
MAX_ZIP_UNCOMPRESSED_MB=200
ARTIFACT_LINK_TTL_MINUTES=15
PREVIEW_LINK_TTL_MINUTES=60
